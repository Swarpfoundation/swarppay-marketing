# Brevo double-opt-in subscription service (server-side only)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_CONFIRMATION_REDIRECT_URL=https://swarppay.com/subscribe?confirmed=true

# Comma-separated browser origins allowed to submit the form
SUBSCRIBE_ALLOWED_ORIGINS=https://swarppay.com,https://www.swarppay.com

# Use a long random value in production; never expose it to browser code
SUBSCRIBE_RATE_LIMIT_SALT=
